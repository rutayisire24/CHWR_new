# Copy to .env and adjust. The server reads plain environment variables;
# nothing here has a default except where noted.
DATABASE_URL=postgres:///chwr
ADDR=:8080
ENV=dev
SHUTDOWN_TIMEOUT=15s

# Addresses whose X-Forwarded-For may be believed, for when a reverse proxy sits
# in front. Empty — the default — means no header is trusted and the client
# address is always the peer's own. See docs/deploy.md.
TRUSTED_PROXY=
