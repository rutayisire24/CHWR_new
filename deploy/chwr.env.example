# Copy to /etc/chwr/chwr.env, fill in, and lock it down:
#
#   sudo install -d -m 0750 -o root -g chwr /etc/chwr
#   sudo install -m 0640 -o root -g chwr deploy/chwr.env.example /etc/chwr/chwr.env
#
# It carries the database password, so it is not world-readable and does not
# belong in git.

# Required. No default: a wrong-database default is worse than a refusal to
# start, so the server exits if this is unset.
DATABASE_URL=postgres://chwr:CHANGE-ME@127.0.0.1:5432/chwr?sslmode=disable

# Bind to the loopback only. TLS is the reverse proxy's job, and a public bind
# would let anyone skip it — along with the Secure cookies it makes possible.
ADDR=127.0.0.1:8080

# prod is what puts Secure on the session, CSRF and flash cookies. It therefore
# requires that browsers reach the service over HTTPS; set it only once the
# proxy in front is terminating TLS, or nobody will be able to sign in.
ENV=prod

# How long in-flight requests may finish on SIGTERM. A bulk import commit is
# the longest thing this service does — about 3 seconds per thousand rows — so
# raise this if large imports are routine.
SHUTDOWN_TIMEOUT=15s

# The proxy in front, whose X-Forwarded-For may be believed. Without it every
# audit_log row records the proxy's own address instead of the user's, and
# audit_log doubles as the CHW change history. A list of addresses or CIDR
# blocks; empty means no header is ever trusted.
TRUSTED_PROXY=127.0.0.1
